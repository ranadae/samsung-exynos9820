    if 'ANDROID_MAJOR_VERSION' in env:
        print('ANDROID_MAJOR_VERSION="' + env['ANDROID_MAJOR_VERSION'] + '"')
    print('KBUILD_BUILD_TIMESTAMP="' + env['KBUILD_BUILD_TIMESTAMP'] + '"')

    run(cmd, env=env, check=True)

def disable_magisk_initramfs_source(output_dir):
    config_path = os.path.join(output_dir, '.config')
    if not os.path.exists(config_path):
        print(f"Warning: .config file not found at {config_path}. Skipping Magisk initramfs source disabling.", file=stderr)
        return

    lines = []
    modified = False
    with open(config_path, 'r') as f:
        for line in f:
            if line.startswith('CONFIG_INITRAMFS_SOURCE=') and 'usr/magisk' in line:
                print(f"Disabling CONFIG_INITRAMFS_SOURCE for Magisk: {line.strip()}")
                lines.append('# ' + line) # Comment out the line
                lines.append('CONFIG_INITRAMFS_SOURCE=""\n') # Set it to empty
                modified = True
            else:
                lines.append(line)

    if modified:
        with open(config_path, 'w') as f:
            f.writelines(lines)
        print("Successfully disabled Magisk initramfs source in .config.")
    else:
        print("No Magisk initramfs source found in .config to disable.")

def build_kernel(configs):
    output_dir = configs['O'] if 'O' in configs else '.'

    if 'O' in configs:
        mkdir(configs['O'])
        mount_tmpfs(configs['O'], OBJTREE_SIZE_GB)

    try:
        # Clean the kernel build directory
        run_make_cmd(configs, 'mrproper')

        # Apply defconfig
        model_config = models[configs['model']]['config']
        run_make_cmd(configs, 'defconfig', model_config)

        # Disable CONFIG_INITRAMFS_SOURCE if it points to usr/magisk
        if 'magisk' in configs['kernel'] and configs['kernel']['magisk']['enabled']:
            disable_magisk_initramfs_source(output_dir)

        # Build the kernel
        run_make_cmd(configs, 'Image.gz')

        # Build modules
        run_make_cmd(configs, 'modules')

        # Install modules
        run_make_cmd(configs, 'modules_install')

    finally:
        if 'O' in configs:
            umount_tmpfs(configs['O'])

