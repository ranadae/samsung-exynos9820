    env['ARCH'] = 'arm64'
    env['SUBARCH'] = 'arm64'
    env['KBUILD_BUILD_USER'] = 'Magisk'
    env['KBUILD_BUILD_HOST'] = 'Here'
    env['KBUILD_BUILD_TIMESTAMP'] = ''

