def main():
    stages = parse_stage()
    configs = parse_args()

    if 'config' in stages:
        save_config('config.json', configs)

    if 'build' in stages:
        build_kernel(configs)

    if 'mkimg' in stages:
        mkimg(configs)

    if 'pack' in stages:
        pack(configs)

    if 'magisk' in configs['kernel'] and configs['kernel']['magisk']['enabled']:
        update_magisk(configs['kernel']['magisk'].get('version'))
        print('Magisk Version: ' + configs['kernel']['magisk'].get('version', 'N/A'))

